<script type="text/javascript">
var currentStep = 1;

function updateStepperUI(step) {
    for (var i = 1; i <= 3; i++) {
        var $stepEl = $('#stepperStep' + i);
        $stepEl.removeClass('active completed pending');
        if (i < step) {
            $stepEl.addClass('completed');
        } else if (i === step) {
            $stepEl.addClass('active');
        } else {
            $stepEl.addClass('pending');
        }
    }

    if (step === 1) {
        $('#trackFill1').css('width', '0%');
        $('#trackFill2').css('width', '0%');
    } else if (step === 2) {
        $('#trackFill1').css('width', '100%');
        $('#trackFill2').css('width', '0%');
    } else if (step >= 3) {
        $('#trackFill1').css('width', '100%');
        $('#trackFill2').css('width', '100%');
    }

    if (step === 3) {
        updateTicketPreview();
    }
}

function selectTicketLocation(id, name, stampClass, iconClass, el) {
    id = parseInt(id);
    $('#forced_locations_id').val(id);

    $('.user-location-card').removeClass('is-selected');
    if (el) {
        $(el).addClass('is-selected');
    } else {
        var $matching = $('.user-location-card[data-loc-id="' + id + '"]');
        if ($matching.length) {
            $matching.addClass('is-selected');
        }
    }

    var $stamp = $('#ticket-location-stamp-display');
    if ($stamp.length) {
        $stamp.attr('class', 'user-location-stamp-tag ' + stampClass);
        $stamp.html('<i class="' + iconClass + '"></i> <span id="ticketLocationStampText">' + name.toUpperCase() + '</span>');
    }

    var $locSelect = $('select[name="locations_id"]');
    if ($locSelect.length) {
        if ($locSelect.val() != id && $locSelect.find('option[value="' + id + '"]').length) {
            $locSelect.val(id).trigger('change.select2');
        }
    }

    $('#previewLocVal').text(name);
}


function resolveUrgencyForCategory(catId, catTitle) {
    catId = parseInt(catId) || 0;
    var title = (catTitle || '').toLowerCase();

    // 1. Verificar atributos data do card correspondente
    var $card = $('.apple-category-card[data-category-id="' + catId + '"]');
    if (!$card.length && catId === 0) {
        $card = $('.apple-category-card.active');
    }
    if ($card.length && $card.data('urgency')) {
        var uVal = parseInt($card.data('urgency'));
        return {
            urgency: uVal,
            name: $card.data('urgency-name') || (uVal === 4 ? 'Alta' : (uVal === 2 ? 'Baixa' : 'Média')),
            color: $card.data('urgency-color') || (uVal === 4 ? '#F59E0B' : (uVal === 2 ? '#10B981' : '#3B82F6'))
        };
    }

    // 2. Sistema & ERP: Alta (4)
    if (title.indexOf('sistema') !== -1 || title.indexOf('erp') !== -1 || title.indexOf('winthor') !== -1) {
        return { urgency: 4, name: 'Alta', color: '#F59E0B' };
    }
    // 3. Computadores: Alta (4)
    if (title.indexOf('computador') !== -1 || title.indexOf('hardware') !== -1 || title.indexOf('notebook') !== -1 || title.indexOf('pc') !== -1) {
        return { urgency: 4, name: 'Alta', color: '#F59E0B' };
    }
    // 4. Redes & Internet: Média (3)
    if (title.indexOf('rede') !== -1 || title.indexOf('internet') !== -1 || title.indexOf('wifi') !== -1 || title.indexOf('vpn') !== -1 || title.indexOf('link') !== -1) {
        return { urgency: 3, name: 'Média', color: '#3B82F6' };
    }
    // 5. Impressoras: Média (3)
    if (title.indexOf('impressora') !== -1 || title.indexOf('impress') !== -1 || title.indexOf('toner') !== -1 || title.indexOf('scanner') !== -1) {
        return { urgency: 3, name: 'Média', color: '#3B82F6' };
    }
    // 6. E-mail & Acessos: Baixa (2)
    if (title.indexOf('email') !== -1 || title.indexOf('e-mail') !== -1 || title.indexOf('acesso') !== -1 || title.indexOf('senha') !== -1) {
        return { urgency: 2, name: 'Baixa', color: '#10B981' };
    }
    // 7. Dúvidas & Apoio: Baixa (2)
    if (title.indexOf('duvida') !== -1 || title.indexOf('dúvida') !== -1 || title.indexOf('apoio') !== -1 || title.indexOf('suporte') !== -1 || title.indexOf('ajuda') !== -1) {
        return { urgency: 2, name: 'Baixa', color: '#10B981' };
    }

    // Padrão: Média (3)
    return { urgency: 3, name: 'Média', color: '#3B82F6' };
}

function applyAutomaticUrgency(urgVal, urgName, urgColor) {
    urgVal = parseInt(urgVal) || 3;
    if (!urgName) {
        if (urgVal === 4) { urgName = 'Alta'; urgColor = '#F59E0B'; }
        else if (urgVal === 2) { urgName = 'Baixa'; urgColor = '#10B981'; }
        else { urgName = 'Média'; urgColor = '#3B82F6'; }
    }
    $('#forcedUrgency').val(urgVal);
    $('#forcedImpact').val(urgVal);
    $('#forcedPriority').val(urgVal);

    var $urgSelect = $('select[name="urgency"]');
    if ($urgSelect.length) {
        if (!$urgSelect.find('option[value="' + urgVal + '"]').length) {
            $urgSelect.append(new Option(urgName, urgVal, true, true));
        }
        $urgSelect.val(urgVal).trigger('change.select2').trigger('change');
    }

    $('#previewUrgVal').html('<span class="urgency-dot-sm me-1" style="background-color: ' + urgColor + ';"></span> ' + urgName);
}

function updateTicketPreview() {
    var isIncident = $('#appleTypeSegment .apple-segment-btn[data-type="1"]').hasClass('active');
    $('#previewTypeBadge').text(isIncident ? 'Incidente (Problema)' : 'Requisição (Serviço)');
    if (isIncident) {
        $('#previewTypeBadge').removeClass('bg-primary-subtle text-primary').addClass('bg-danger-subtle text-danger');
    } else {
        $('#previewTypeBadge').removeClass('bg-danger-subtle text-danger').addClass('bg-primary-subtle text-primary');
    }

    var activeCatTitle = $('.apple-category-card.active .apple-cat-title').text();
    if (!activeCatTitle || activeCatTitle.trim() === '') {
        var nativeCatText = $('select[name="itilcategories_id"] option:selected').text();
        activeCatTitle = (nativeCatText && nativeCatText.trim() !== '' && nativeCatText.indexOf('-----') === -1) ? nativeCatText : 'Sistemas & ERP';
    }
    $('#previewCatVal').text(activeCatTitle.trim());

    // Sincronizar Urgência Automática baseada na Categoria
    var catId = $('#forcedItilCategoryId').val() || $('select[name="itilcategories_id"]').val();
    var urgInfo = resolveUrgencyForCategory(catId, activeCatTitle);
    applyAutomaticUrgency(urgInfo.urgency, urgInfo.name, urgInfo.color);

    var $locSelect = $('select[name="locations_id"]');
    var locText = $locSelect.find('option:selected').text();
    if (!locText || locText.trim() === '' || locText.indexOf('-----') !== -1) {
        var activeCardText = $('.user-location-card.is-selected .loc-card-badge').text();
        locText = activeCardText && activeCardText.trim() !== '' ? activeCardText : '{{ user_location_name|default("Brago-DF") }}';
    }
    $('#previewLocVal').text(locText.trim());

    var titleVal = $('input[name="name"]').val();
    $('#previewTitleVal').text(titleVal && titleVal.trim() !== '' ? titleVal : '(Sem título informado)');
}

function hasDescriptionContent() {
    var $textarea = $('textarea[name="content"]');
    var rawText = $textarea.val() || '';

    // Check TinyMCE if active
    if (typeof tinymce !== 'undefined') {
        var editorId = $textarea.attr('id');
        var ed = (editorId && tinymce.get(editorId)) ? tinymce.get(editorId) : tinymce.activeEditor;
        if (ed && !ed.isHidden()) {
            var html = ed.getContent();
            // If it has images, audio, video, attachments, or tables, it's not empty
            if (/<(img|video|audio|table|figure|iframe|object|embed)/i.test(html) || html.indexOf('data:image') !== -1) {
                return true;
            }
            var text = ed.getContent({format: 'text'}) || '';
            text = text.replace(/[\s\u00a0\u200B]+/g, ' ').trim();
            if (text.length > 0) {
                return true;
            }
            return false;
        }
    }

    // Check plain textarea
    var cleanText = rawText.replace(/[\s\u00a0\u200B]+/g, ' ').trim();
    if (cleanText.length > 0) {
        return true;
    }

    // Check if any files are attached in GLPI's file upload container in the description group
    if ($('#descriptionInputGroup').find('.fileupload-item, .file-item, .uploaded-file, .upload-element').length > 0) {
        return true;
    }

    return false;
}

function goToStep(targetStep) {
    if (targetStep === currentStep) return;

    if (targetStep > 1 && currentStep === 1) {
        if (!$('.apple-category-card.active').length) {
            $('.apple-category-card').first().addClass('active');
        }
    }

    // Validação ao tentar avançar para a Etapa 3 (Localização e Envio)
    if (targetStep === 3) {
        var titleVal = $('input[name="name"]').val();
        if (!titleVal || titleVal.trim() === '') {
            if (currentStep !== 2) {
                currentStep = 2;
                $('.apple-wizard-step').hide();
                $('#step2Details').fadeIn(240);
                updateStepperUI(2);
            }
            $('#titleRequiredAlert').removeClass('d-none');
            var $titleInput = $('input[name="name"]');
            $titleInput.addClass('input-shake').focus();
            setTimeout(function() {
                $titleInput.removeClass('input-shake');
            }, 500);
            $('html, body').animate({
                scrollTop: $('#titleInputGroup').offset().top - 20
            }, 200);
            return;
        } else {
            $('#titleRequiredAlert').addClass('d-none');
        }

        if (!hasDescriptionContent()) {
            if (currentStep !== 2) {
                currentStep = 2;
                $('.apple-wizard-step').hide();
                $('#step2Details').fadeIn(240);
                updateStepperUI(2);
            }
            $('#descriptionRequiredAlert').removeClass('d-none');
            var $textarea = $('textarea[name="content"]');
            var editorId = $textarea.attr('id');
            var $editorBox = $('#descriptionInputGroup .tox-tinymce');
            if ($editorBox.length) {
                $editorBox.addClass('input-shake');
                setTimeout(function() {
                    $editorBox.removeClass('input-shake');
                }, 500);
                if (typeof tinymce !== 'undefined') {
                    var ed = (editorId && tinymce.get(editorId)) ? tinymce.get(editorId) : tinymce.activeEditor;
                    if (ed) ed.focus();
                }
            } else {
                $textarea.addClass('input-shake').focus();
                setTimeout(function() {
                    $textarea.removeClass('input-shake');
                }, 500);
            }
            $('html, body').animate({
                scrollTop: $('#descriptionInputGroup').offset().top - 30
            }, 200);
            return;
        } else {
            $('#descriptionRequiredAlert').addClass('d-none');
        }
    }

    $('.apple-wizard-step').hide();
    var targetContainerId = (targetStep === 1) ? '#step1Category' : ((targetStep === 2) ? '#step2Details' : '#step3Location');
    $(targetContainerId).fadeIn(240);

    currentStep = targetStep;
    updateStepperUI(currentStep);

    $('html, body').animate({
        scrollTop: $('.apple-wizard-stepper-wrap').offset().top - 20
    }, 280);
}

$(function () {
    // 1. Alternância de Tipo (Incidente / Requisição)
    $('#appleTypeSegment .apple-segment-btn').on('click', function(e) {
        e.preventDefault();
        $('#appleTypeSegment .apple-segment-btn').removeClass('active');
        $(this).addClass('active');

        var typeVal = $(this).data('type');
        $('select[name="type"]').val(typeVal).trigger('change');
    });

    // 2. Seleção de Card de Categoria
    $('.apple-category-card').on('click', function() {
        $('.apple-category-card').removeClass('active');
        $(this).addClass('active');

        var catId = $(this).data('category-id');
        var catTitle = $(this).find('.apple-cat-title').text().trim();
        var keywords = ($(this).data('keywords') || '').toLowerCase().split(',');

        if (catId) {
            $('#forcedItilCategoryId').val(catId);
        }

        var $catSelect = $('select[name="itilcategories_id"]');
        if ($catSelect.length && catId) {
            if (!$catSelect.find('option[value="' + catId + '"]').length) {
                var newOption = new Option(catTitle, catId, true, true);
                $catSelect.append(newOption);
            }
            $catSelect.val(catId).trigger('change.select2').trigger('change');
        }

        var cardUrg = $(this).data('urgency');
        var cardUrgName = $(this).data('urgency-name');
        var cardUrgColor = $(this).data('urgency-color');
        if (cardUrg) {
            applyAutomaticUrgency(cardUrg, cardUrgName, cardUrgColor);
        } else {
            var urgInfo = resolveUrgencyForCategory(catId, catTitle);
            applyAutomaticUrgency(urgInfo.urgency, urgInfo.name, urgInfo.color);
        }

        updateTicketPreview();

        // Feedback suave: Avança automaticamente para o passo 2
        setTimeout(function() {
            goToStep(2);
        }, 220);
    });

    // Botão de Avanço Manual da Etapa 1
    $('#btnNextToStep2').on('click', function() {
        goToStep(2);
    });

    // Sincronizar card inicial caso já exista categoria selecionada
    var currentCat = $('#forcedItilCategoryId').val() || $('select[name="itilcategories_id"]').val();
    if (currentCat && currentCat != '0') {
        var $targetCard = $('.apple-category-card[data-category-id="' + currentCat + '"]');
        if ($targetCard.length) {
            $('.apple-category-card').removeClass('active');
            $targetCard.addClass('active');
        }
    } else {
        if (!$('.apple-category-card.active').length) {
            var $firstCard = $('.apple-category-card').first();
            $firstCard.addClass('active');
            var firstCatId = $firstCard.data('category-id');
            if (firstCatId) {
                $('#forcedItilCategoryId').val(firstCatId);
            }
        }
    }

    // Toggle para outras categorias
    $('#btnToggleOtherCategory').on('click', function() {
        $('#wrapperOtherCategory').toggleClass('d-none');
    });

    // Sincronizar quando a categoria mudar pelo dropdown nativo
    $(document).on('change', 'select[name="itilcategories_id"]', function() {
        var val = $(this).val();
        if (val && val != '0') {
            $('#forcedItilCategoryId').val(val);
            $('.apple-category-card').removeClass('active');
            var $matchingCard = $('.apple-category-card[data-category-id="' + val + '"]');
            if ($matchingCard.length) {
                $matchingCard.addClass('active');
            }
            var text = $(this).find('option:selected').text().trim();
            var urgInfo = resolveUrgencyForCategory(val, text);
            applyAutomaticUrgency(urgInfo.urgency, urgInfo.name, urgInfo.color);
            updateTicketPreview();
        }
    });

    // Sincronizar quando a localização for alterada
    $(document).on('change', 'select[name="locations_id"]', function() {
        var val = parseInt($(this).val() || '0');
        var text = $(this).find('option:selected').text().trim();
        if (val > 0) {
            $('#forced_locations_id').val(val);
            $('#previewLocVal').text(text);

            $('.user-location-card').removeClass('is-selected');
            var $stamp = $('#ticket-location-stamp-display');

            if (val === 1) {
                $('.user-location-card.card-df').addClass('is-selected');
                if ($stamp.length) {
                    $stamp.attr('class', 'user-location-stamp-tag stamp-df');
                    $stamp.html('<i class="ti ti-building"></i> <span id="ticketLocationStampText">BRAGO-DF</span>');
                }
            } else if (val === 5) {
                $('.user-location-card.card-to').addClass('is-selected');
                if ($stamp.length) {
                    $stamp.attr('class', 'user-location-stamp-tag stamp-to');
                    $stamp.html('<i class="ti ti-map-pin"></i> <span id="ticketLocationStampText">BRAGO-TO</span>');
                }
            } else if (val === 6) {
                $('.user-location-card.card-go').addClass('is-selected');
                if ($stamp.length) {
                    $stamp.attr('class', 'user-location-stamp-tag stamp-go');
                    $stamp.html('<i class="ti ti-map-pin"></i> <span id="ticketLocationStampText">BRAGO-GO</span>');
                }
            } else if (val === 7) {
                $('.user-location-card.card-ms').addClass('is-selected');
                if ($stamp.length) {
                    $stamp.attr('class', 'user-location-stamp-tag stamp-ms');
                    $stamp.html('<i class="ti ti-map-pin"></i> <span id="ticketLocationStampText">BRAGO-MS</span>');
                }
            } else {
                if ($stamp.length) {
                    $stamp.attr('class', 'user-location-stamp-tag stamp-custom');
                    $stamp.html('<i class="ti ti-map-pin"></i> <span id="ticketLocationStampText">' + (text || 'LOCAL ' + val).toUpperCase() + '</span>');
                }
            }
        }
        updateTicketPreview();
    });

    // Auto-selecionar a localização registrada do usuário ao carregar
    var autoLocId = parseInt($('#forced_locations_id').val() || '{{ effective_loc_id }}');
    if (autoLocId === 5) {
        selectTicketLocation(5, 'Brago-TO', 'stamp-to', 'ti ti-map-pin');
    } else if (autoLocId === 6) {
        selectTicketLocation(6, 'Brago-GO', 'stamp-go', 'ti ti-map-pin');
    } else if (autoLocId === 7) {
        selectTicketLocation(7, 'Brago-MS', 'stamp-ms', 'ti ti-map-pin');
    } else if (autoLocId === 1) {
        selectTicketLocation(1, 'Brago-DF', 'stamp-df', 'ti ti-building');
    } else if (autoLocId > 0) {
        var $locSel = $('select[name="locations_id"]');
        var custName = $locSel.find('option[value="' + autoLocId + '"]').text() || 'Local ' + autoLocId;
        selectTicketLocation(autoLocId, custName, 'stamp-custom', 'ti ti-map-pin');
    }


    // 4. Chips de Sugestão Rápida para o Título
    $('.suggestion-chip').on('click', function() {
        var suggested = $(this).data('title');
        var $input = $('input[name="name"]');
        $input.val(suggested).trigger('input').trigger('change').focus();
        $('#titleRequiredAlert').addClass('d-none');
        $input.removeClass('input-shake');

        // Mapear automaticamente a categoria pelo chip clicado
        var lower = (suggested || '').toLowerCase();
        $('.apple-category-card').each(function() {
            var kws = ($(this).data('keywords') || '').toLowerCase().split(',');
            for (var i = 0; i < kws.length; i++) {
                var kw = kws[i].trim();
                if (kw && lower.indexOf(kw) !== -1) {
                    $('.apple-category-card').removeClass('active');
                    $(this).addClass('active');
                    var cId = $(this).data('category-id');
                    var cTitle = $(this).find('.apple-cat-title').text().trim();
                    $('#forcedItilCategoryId').val(cId);
                    var $catSelect = $('select[name="itilcategories_id"]');
                    if ($catSelect.length && cId) {
                        if (!$catSelect.find('option[value="' + cId + '"]').length) {
                            $catSelect.append(new Option(cTitle, cId, true, true));
                        }
                        $catSelect.val(cId).trigger('change.select2').trigger('change');
                    }
                    return false;
                }
            }
        });

        updateTicketPreview();
    });

    // Limpeza de alerta de título em tempo real
    $('input[name="name"]').on('input keyup change paste', function() {
        if ($(this).val().trim() !== '') {
            $('#titleRequiredAlert').addClass('d-none');
            $(this).removeClass('input-shake');
        }
        updateTicketPreview();
    });

    // Limpeza de alerta de descrição em tempo real (Textarea nativo)
    $('textarea[name="content"]').on('input keyup change paste', function() {
        if (hasDescriptionContent()) {
            $('#descriptionRequiredAlert').addClass('d-none');
            $('#descriptionInputGroup .tox-tinymce, textarea[name="content"]').removeClass('input-shake');
        }
    });

    // Limpeza de alerta de descrição em tempo real (TinyMCE)
    if (typeof tinymce !== 'undefined') {
        tinymce.on('AddEditor', function(e) {
            e.editor.on('input keyup change NodeChange paste SetContent', function() {
                if (hasDescriptionContent()) {
                    $('#descriptionRequiredAlert').addClass('d-none');
                    $('#descriptionInputGroup .tox-tinymce').removeClass('input-shake');
                }
            });
        });
        if (tinymce.editors && tinymce.editors.length) {
            tinymce.editors.forEach(function(ed) {
                ed.on('input keyup change NodeChange paste SetContent', function() {
                    if (hasDescriptionContent()) {
                        $('#descriptionRequiredAlert').addClass('d-none');
                        $('#descriptionInputGroup .tox-tinymce').removeClass('input-shake');
                    }
                });
            });
        }
    }

    // Enter no campo de título avança para a etapa 3
    $('input[name="name"]').on('keydown', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            goToStep(3);
        }
    });

    // 5. Botão de Avanço da Etapa 2
    $('#btnNextToStep3').on('click', function() {
        goToStep(3);
    });

    // 6. Interceptador de Envio Final para Garantir Integridade
    $('#btnSubmitTicket').closest('form').on('submit', function(e) {
        var forcedCat = $('#forcedItilCategoryId').val();
        if (forcedCat && forcedCat != '0') {
            var $catSelect = $('select[name="itilcategories_id"]');
            if ($catSelect.length) {
                if (!$catSelect.find('option[value="' + forcedCat + '"]').length) {
                    var cardTitle = $('.apple-category-card[data-category-id="' + forcedCat + '"] .apple-cat-title').text().trim() || 'Categoria';
                    $catSelect.append(new Option(cardTitle, forcedCat, true, true));
                }
                $catSelect.val(forcedCat);
            }
        }

        // Garante envio da urgência automática calculada
        var urgVal = parseInt($('#forcedUrgency').val() || '4');
        var $urgSelect = $('select[name="urgency"]');
        if ($urgSelect.length) {
            if (!$urgSelect.find('option[value="' + urgVal + '"]').length) {
                $urgSelect.append(new Option('Urgência', urgVal, true, true));
            }
            $urgSelect.val(urgVal);
        }

        var titleVal = $('input[name="name"]').val();
        if (!titleVal || titleVal.trim() === '') {
            e.preventDefault();
            goToStep(2);
            $('#titleRequiredAlert').removeClass('d-none');
            var $titleInput = $('input[name="name"]');
            $titleInput.addClass('input-shake').focus();
            setTimeout(function() { $titleInput.removeClass('input-shake'); }, 500);
            return false;
        }
        if (!hasDescriptionContent()) {
            e.preventDefault();
            goToStep(2);
            $('#descriptionRequiredAlert').removeClass('d-none');
            var $textarea = $('textarea[name="content"]');
            var editorId = $textarea.attr('id');
            var $editorBox = $('#descriptionInputGroup .tox-tinymce');
            if ($editorBox.length) {
                $editorBox.addClass('input-shake');
                setTimeout(function() { $editorBox.removeClass('input-shake'); }, 500);
                if (typeof tinymce !== 'undefined') {
                    var ed = (editorId && tinymce.get(editorId)) ? tinymce.get(editorId) : tinymce.activeEditor;
                    if (ed) ed.focus();
                }
            } else {
                $textarea.addClass('input-shake').focus();
                setTimeout(function() { $textarea.removeClass('input-shake'); }, 500);
            }
            return false;
        }
    });

    // 7. Delegação
    $('#dropdown_nodelegate{{ rand }}').on('change', function() {
        var is_for_me = ($(this).val() == '1');
        if (is_for_me) {
            $('#delegate_other{{ rand }}').addClass("d-none");
            $('#delegate_other{{ rand }} .card-body').html("");
        } else {
            $('#delegate_other{{ rand }} .card-body')
                .html("")
                .load('{{ path('ajax/dropdownDelegationUsers.php') }}', {
                    'right': "delegate",
                    'nodelegate': (is_for_me ? 1 : 0),
                    '_users_id_requester': {{ params['_users_id_requester'] ?? 0 }},
                    '_users_id_requester_notif': {{ params['_users_id_requester_notif']|json_encode()|raw }},
                    'use_notification': {{ params['_users_id_requester_notif']['use_notification'] is defined ? (params['_users_id_requester_notif']['use_notification'] is array ? params['_users_id_requester_notif']['use_notification'][0] : params['_users_id_requester_notif']['use_notification']) : 1 }},
                    'entity_restrict':  {{ session('glpiactive_entity') }}
                }, () => {
                    $('#delegate_other{{ rand }}').removeClass("d-none");
                })
            ;
        }
    });

    if (typeof saveActorsToDom === 'function') {
        saveActorsToDom();
    }

    // Inicialização da Urgência Automática
    updateTicketPreview();
});
</script>

