{% extends 'components/itilobject/timeline/form_timeline_item.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% set params = {'item': item}|merge(params|default({})) %}

{% set candedit = item.maySolve() %}
{% set can_read_kb = has_profile_right('knowbase', constant('READ')) or has_profile_right('knowbase', constant('KnowbaseItem::READFAQ')) %}
{% set can_update_kb = has_profile_right('knowbase', constant('UPDATE')) %}
{% set nokb = params['nokb'] is defined or (params['nokb'] ?? false) == true %}
{% set rand = random() %}
{% set is_default_pending = false %}

{% set content_field_id = 'solution_content_' ~ rand %}

{% block timeline_card %}
   {% if form_mode == 'view' %}
      <div class="read-only-content">
         <div class="rich_text_container">
            {{ entry_i['content']|enhanced_html({
               'user_mentions': true,
               'images_gallery': true
            }) }}
         </div>

         <div class="timeline-badges">
            {% if entry_i['requesttypes_id'] %}
               <span class="badge bg-blue-lt" title="{{ __('Source of followup') }}">
                  <i class="ti ti-inbox me-1"></i>
                  {{ get_item_name('RequestType', entry_i['requesttypes_id']) }}
               </span>
            {% endif %}

            {% if entry_i['sourceitems_id'] %}
               <span class="badge bg-blue-lt">
                  <i class="ti ti-git-merge me-1"></i>
                  {% set merged_badge %}
                     <span class="badge">
                        {{ get_item_link('Ticket', entry_i['sourceitems_id']) }}
                     </span>
                  {% endset %}
                  {{ __('Merged from Ticket %1$s')|format(merged_badge)|raw }}
               </span>
            {% endif %}

            {% if entry_i['sourceof_items_id'] %}
               <span class="badge bg-blue-lt">
                  <i class="ti ti-git-merge me-1"></i>
                  {% set promoted_badge %}
                     <span class="badge">
                        {{ get_item_link('Ticket', entry_i['sourceof_items_id']) }}
                     </span>
                  {% endset %}
                  {{ __('Promoted to Ticket %1$s')|format(promoted_badge)|raw }}
               </span>
            {% endif %}

            {{ include('components/itilobject/timeline/pending_reasons_messages.html.twig') }}
         </div>
      </div>
   {% else %}
      <div class="itilfollowup">
         <form name="asset_form" style="width: 100%;" class="d-flex flex-column" method="post"
               action="{{ subitem.getFormURL() }}" enctype="multipart/form-data" data-track-changes="true" data-submit-once>
            <input type="hidden" name="itemtype" value="{{ item.getType() }}" />
            <input type="hidden" name="items_id" value="{{ item.fields['id'] }}" />
            {{ call_plugin_hook(constant('Glpi\\Plugin\\Hooks::PRE_ITEM_FORM'), {"item": subitem, 'options': params}) }}

            {% set add_reopen = (_get['_openfollowup'] ?? false) or item.needReopen() %}
            {% if add_reopen %}
               <input type="hidden" name="add_reopen" value="1" />
            {% endif %}

            <div class="row mx-n3 mx-xxl-auto">
               {% set col_md = get_current_interface() == 'central' ? 'col-xl-7 col-xxl-8' : 'col-xxl-12' %}
               <div class="col-12 {{ col_md }}">
                  <div id="chat-attachment-previews" class="chat-attachment-previews"></div>
                  {{ fields.textareaField(
                     'content',
                     subitem.fields['content'],
                     '',
                     {
                        'id': content_field_id,
                        'full_width': true,
                        'no_label': true,
                        'enable_richtext': false,
                        'enable_fileupload': true,
                        'mention_options': mention_options,
                        'entities_id': item.fields['entities_id'],
                        'rand': rand,
                        'required': add_reopen,
                        'aria_label': _n('Followup', 'Followups', 1),
                        'placeholder': 'Digite uma mensagem',
                        'rows': 1,
                        'additional_attributes': {
                           'placeholder': 'Digite uma mensagem',
                           'rows': '1',
                        },
                     }
                  ) }}
                  <script>
                     $(function() {
                        const $fupTextarea = $('#{{ content_field_id }}');
                        const $fupBlock = $('#new-ITILFollowup-block');
                        const $previewContainer = $('#chat-attachment-previews');

                         // Mover .fileupload_info para o container de previews logo acima da barra de mensagem
                         const $fuInfo = $fupBlock.find('.fileupload .fileupload_info');
                         if ($fuInfo.length && $previewContainer.length) {
                            $previewContainer.append($fuInfo);
                         }

                         // Map de miniaturas para imagens coladas/arrastadas/selecionadas
                         window._chatThumbMap = window._chatThumbMap || {};

                         // Patch de segurança para exclusão de anexo (quando sem RichText/TinyMCE)
                         if (!window._deleteImagePastedPatched) {
                            window._deleteImagePastedPatched = true;
                            const origDelete = window.deleteImagePasted;
                            window.deleteImagePasted = function(e, t, n) {
                               if (Array.isArray(e)) {
                                  $.each(e, function(idx, idVal) { $('#' + idVal).remove(); });
                               }
                               if (n && typeof n.dom !== 'undefined' && t) {
                                  var a = new RegExp('#', 'g');
                                  n.dom.remove(t.replace(a, ''));
                               } else if (typeof origDelete === 'function') {
                                  try { origDelete(e, t, n); } catch(err) {}
                               }
                            };
                         }

                         const $fileInput = $fupBlock.find('.fileupload input[type="file"][name^="_uploader_"]');

                         function registerImageThumbs(files) {
                            if (!files) return;
                            Array.from(files).forEach(function(file) {
                               if (file.type && file.type.indexOf('image') !== -1) {
                                  try {
                                     const blobUrl = URL.createObjectURL(file);
                                     window._chatThumbMap[file.name] = blobUrl;
                                     if (file.size) window._chatThumbMap[file.size] = blobUrl;
                                  } catch (err) {}
                               }
                            });
                         }

                         if ($fileInput.length) {
                            $fileInput.on('fileuploadadd', function(e, data) {
                               if (data && data.files) registerImageThumbs(data.files);
                            });
                            $fileInput.on('change', function() {
                               if (this.files) registerImageThumbs(this.files);
                            });
                         }

                         // Observar adições em .fileupload_info para injetar miniaturas de imagem estilo WhatsApp
                         if (window.MutationObserver && $fuInfo.length) {
                            const enhancePreview = function($p) {
                               if ($p.hasClass('chat-thumb-enhanced')) return;
                               $p.addClass('chat-thumb-enhanced');
                               
                               const pText = $p.text() || '';
                               const bText = $p.find('b').text() || '';
                               const hiddenVal = $p.find('input[name*="_filename"]').val() || '';
                               
                               let matchedThumb = null;
                               for (let key in window._chatThumbMap) {
                                  if (pText.indexOf(key) !== -1 || bText.indexOf(key) !== -1 || hiddenVal.indexOf(key) !== -1) {
                                     matchedThumb = window._chatThumbMap[key];
                                     break;
                                  }
                               }
                               
                               if (matchedThumb) {
                                  $p.find('img').remove();
                                  $p.prepend('<img src="' + matchedThumb + '" class="chat-thumb-preview" alt="Preview" />');
                               } else {
                                  const isImg = /\.(jpe?g|png|gif|webp|bmp|svg)/i.test(pText + ' ' + hiddenVal);
                                  if (isImg) {
                                     $p.find('img').first().addClass('chat-thumb-preview');
                                  }
                               }
                            };

                            const observer = new MutationObserver(function(mutations) {
                               $fuInfo.find('p').each(function() {
                                  enhancePreview($(this));
                               });
                            });
                            observer.observe($fuInfo[0], { childList: true, subtree: true });
                            $fuInfo.find('p').each(function() { enhancePreview($(this)); });
                         }

                         // Função central para envio de arquivos pelo uploader do GLPI
                         function uploadFilesToChat(files) {
                            if (!files || !files.length) return;
                            if (!$fileInput.length) return;

                            registerImageThumbs(files);

                            const fileArr = Array.from(files);
                            fileArr.forEach(function(file) {
                               // Trigger jQuery File Upload
                               if (typeof $fileInput.fileupload === 'function') {
                                  $fileInput.fileupload('add', { files: [file] });
                               } else if (window.DataTransfer) {
                                  const dt = new DataTransfer();
                                  dt.items.add(file);
                                  $fileInput[0].files = dt.files;
                                  $fileInput.trigger('change');
                               }
                            });
                         }

                         // 1. Suporte a colar imagem (Ctrl+V) no textarea ou no chat
                         function handlePasteEvent(e) {
                            const clip = e.clipboardData || e.originalEvent?.clipboardData;
                            if (!clip) return;
                            const items = clip.items;
                            if (!items || !items.length) return;

                            const imagesToUpload = [];
                            for (let i = 0; i < items.length; i++) {
                               if (items[i].type && items[i].type.indexOf('image') !== -1) {
                                  const blob = items[i].getAsFile();
                                  if (blob) {
                                     let fname = blob.name;
                                     if (!fname || fname === 'image.png') {
                                        const now = new Date();
                                        const pad = (n) => String(n).padStart(2, '0');
                                        const ext = blob.type.split('/')[1] || 'png';
                                        fname = 'imagem_' + now.getFullYear() + pad(now.getMonth()+1) + pad(now.getDate()) + '_' + pad(now.getHours()) + pad(now.getMinutes()) + pad(now.getSeconds()) + '.' + ext;
                                        const namedFile = new File([blob], fname, { type: blob.type });
                                        imagesToUpload.push(namedFile);
                                     } else {
                                        imagesToUpload.push(blob);
                                     }
                                  }
                               }
                            }

                            if (imagesToUpload.length > 0) {
                               e.preventDefault();
                               e.stopPropagation();
                               uploadFilesToChat(imagesToUpload);
                            }
                         }

                         if ($fupTextarea.length) {
                            $fupTextarea.attr('placeholder', 'Digite uma mensagem');
                            $fupTextarea.attr('rows', '1');

                            // Enviar com Enter (sem Shift) ou se tiver anexo
                            $fupTextarea.on('keydown', function(e) {
                               if (e.key === 'Enter' && !e.shiftKey) {
                                  e.preventDefault();
                                  if ($(this).val().trim().length > 0 || $fupBlock.find('.fileupload_info p').length > 0) {
                                     $(this).closest('form').find('button[name="add"]').trigger('click');
                                  }
                               }
                            });

                            // Auto-ajuste de altura sutil ao digitar multiplas linhas
                            $fupTextarea.on('input', function() {
                               this.style.height = '36px';
                               if (this.scrollHeight > 36) {
                                  this.style.height = Math.min(this.scrollHeight, 120) + 'px';
                               }
                            });

                            // Focar textarea ao clicar em qualquer lugar da pilula branca
                            $fupTextarea.closest('.col-12.mb-3').on('click', function(e) {
                               if (!$(e.target).closest('.fileupload').length) {
                                  $fupTextarea.focus();
                               }
                            });

                            $fupTextarea.on('paste', handlePasteEvent);
                         }

                         // Interceptar paste de imagem também no bloco do followup e timeline
                         $fupBlock.on('paste', handlePasteEvent);
                         $('.itil-timeline, .itil-left-side').on('paste', handlePasteEvent);

                         // 2. Suporte a Drag & Drop de imagens no chat (estilo WhatsApp)
                         let $overlay = $('#chat-drag-overlay');
                         if (!$overlay.length) {
                            $overlay = $(
                               '<div id="chat-drag-overlay" class="chat-drop-overlay">' +
                                  '<div class="chat-drop-overlay-text">' +
                                     '<i class="ti ti-photo-up" style="font-size: 2.2rem;"></i>' +
                                     '<span>Solte a imagem para anexar ao chamado</span>' +
                                  '</div>' +
                               '</div>'
                            );
                            $('body').append($overlay);
                         }

                         let dragTimer = null;

                         $(window).off('dragenter.zap dragover.zap dragleave.zap drop.zap');

                         $(window).on('dragenter.zap dragover.zap', function(e) {
                            const dt = e.originalEvent?.dataTransfer;
                            if (dt && dt.types && (dt.types.includes('Files') || dt.types.indexOf('Files') !== -1)) {
                               e.preventDefault();
                               if (e.originalEvent?.dataTransfer) {
                                  e.originalEvent.dataTransfer.dropEffect = 'copy';
                               }
                               const $timeline = $('.itil-left-side:visible, #itil-object-container:visible').first();
                               if ($timeline.length) {
                                  const offset = $timeline.offset();
                                  $overlay.css({
                                     top: offset.top,
                                     left: offset.left,
                                     width: $timeline.outerWidth(),
                                     height: $timeline.outerHeight()
                                  });
                               }
                               $overlay.addClass('active');
                               clearTimeout(dragTimer);
                            }
                         });

                         $(window).on('dragleave.zap', function(e) {
                            clearTimeout(dragTimer);
                            if (e.originalEvent.clientX <= 0 || e.originalEvent.clientY <= 0 ||
                                e.originalEvent.clientX >= window.innerWidth || e.originalEvent.clientY >= window.innerHeight) {
                               $overlay.removeClass('active');
                            } else {
                               dragTimer = setTimeout(function() {
                                  $overlay.removeClass('active');
                               }, 150);
                            }
                         });

                         $(window).on('drop.zap', function(e) {
                            clearTimeout(dragTimer);
                            $overlay.removeClass('active');
                            const dt = e.originalEvent?.dataTransfer || e.dataTransfer;
                            if (!dt || !dt.files || !dt.files.length) return;

                            const $t = $(e.target);
                            if ($t.is('#chat-drag-overlay') || $t.closest('#chat-drag-overlay, #itil-object-container, .itil-timeline, .itil-left-side, #new-ITILFollowup-block').length) {
                               e.preventDefault();
                               e.stopPropagation();
                               uploadFilesToChat(dt.files);
                            }
                         });
                     });
                  </script>
               </div>
               {% if get_current_interface() == 'central' %}
                  <div class="col-12 col-xl-5 col-xxl-4 order-first order-md-last pe-0 pe-xxl-auto">
                     <div class="row">

                        {{ include('components/itilobject/timeline/knowledge_item.html.twig') }}

                        {% set fup_template_lbl %}
                           <i class="{{ 'ITILFollowupTemplate'|itemtype_icon }} me-1"
                              title="{{ _n('Followup template', 'Followup templates', get_plural_number()) }}"></i>
                        {% endset %}
                        {{ fields.dropdownField(
                           'ITILFollowupTemplate',
                           'itilfollowuptemplates_id',
                           subitem.fields['itilfollowuptemplates_id'] ?? 0,
                           fup_template_lbl,
                           {
                              'full_width': true,
                              'icon_label': true,
                              'on_change': 'itilfollowuptemplate_update' ~ rand ~ '(this.value)',
                              'entity': item.fields['entities_id'],
                              'rand': rand,
                              'aria_label': _n('Followup template', 'Followup templates', 1),
                           }
                        ) }}

                        {% set fup_source_lbl %}
                           <i class="ti ti-inbox me-1" title="{{ __('Source of followup') }}"></i>
                        {% endset %}
                        {{ fields.dropdownField(
                           'RequestType',
                           'requesttypes_id',
                           subitem.fields['requesttypes_id'],
                           fup_source_lbl,
                           {
                              'full_width': true,
                              'icon_label': true,
                              'condition': {
                                 'is_active': 1,
                                 'is_itilfollowup': 1,
                              },
                              'rand': rand,
                              'aria_label': __('Source of followup'),
                           }
                        ) }}

                        {% set fup_private_lbl %}
                           <i class="ti ti-eye-off me-1" title="{{ __('Private') }}"></i>
                        {% endset %}
                        {{ fields.sliderField(
                           'is_private',
                           subitem.fields['is_private'],
                           fup_private_lbl,
                           {
                              'full_width': true,
                              'icon_label': true,
                              'rand': rand,
                              'additional_attributes': {
                                'onchange': 'toggleTimelinePrivate(this.checked, this)',
                                'data-testid': 'private-switch',
                              }
                           }
                        ) }}

                        {% if candedit and can_update_kb and not nokb %}
                           {% set fup_to_kb_lbl %}
                              <i class="ti ti-device-floppy me-1" title="{{ __('Save and add to the knowledge base') }}"
                                 data-bs-toggle="tooltip" data-bs-placement="top"></i>
                           {% endset %}
                           {{ fields.sliderField(
                              '_fup_to_kb',
                              0,
                              fup_to_kb_lbl,
                              {
                                 'full_width': true,
                                 'icon_label': true,
                                 'rand': rand,
                              }
                           ) }}
                        {% endif %}
                     </div>
                  </div>
               {% endif %}
            </div>

            {{ call_plugin_hook(constant('Glpi\\Plugin\\Hooks::POST_ITEM_FORM'), {"item": subitem, 'options': params}) }}
            {# Fixed min-height ensure no height increase when toggling the pending reason button, as select 2 dropdown are a bit higher than the default footer height #}
            <div class="d-flex card-footer mx-n3 mb-n3 flex-wrap" style="row-gap: 10px; min-height: 79px">
               {% set pending_reasons %}
                  {% set show_pending_reasons_actions = (item.fields['status'] == constant('CommonITILObject::WAITING') or is_default_pending) and not add_reopen %}
                  {% if get_current_interface() == 'central' and item.isAllowedStatus(item.fields['status'], constant('CommonITILObject::WAITING')) and call('PendingReason_Item::canDisplayPendingReasonForItem', [subitem]) %}
                     <span
                        class="input-group-text bg-yellow-lt py-0 pe-0 {{ show_pending_reasons_actions ? 'flex-fill' : '' }}"
                        id="pending-reasons-control-{{ rand }}"
                     >
                        <span class="d-inline-flex align-items-center" title="{{ __("Set the status to pending") }}"
                              data-bs-toggle="tooltip" data-bs-placement="top" role="button">
                           <i class="ti ti-player-pause-filled me-2"></i>
                           <label class="form-check form-switch mt-2">
                              <input type="hidden"   name="pending" value="0" />
                              <input type="checkbox" name="pending" value="1" class="form-check-input"
                                    id="enable-pending-reasons-{{ rand }}"
                                    role="button"
                                    {{ (item.fields['status'] == constant('CommonITILObject::WAITING') or is_default_pending) and not add_reopen ? 'checked' : '' }}
                                    data-bs-toggle="collapse" data-bs-target="#pending-reasons-setup-{{ rand }}"
                                    data-testid="pending-checkbox" />
                           </label>
                        </span>

                        <div
                           class="collapse ps-2 py-1 flex-fill {{ show_pending_reasons_actions ? 'show' : '' }}"
                           aria-expanded="{{ show_pending_reasons_actions ? 'true' : 'false' }}"
                           id="pending-reasons-setup-{{ rand }}"
                        >
                           {{ include('components/itilobject/timeline/pending_reasons.html.twig') }}
                        </div>
                     </span>
                  {% endif %}
               {% endset %}

               {% if subitem.fields['id'] <= 0 %}
                  {# Do not enable flex wrapping when creating a new item as the pending form will be merged with the add button in an input group #}
                  <div class="input-group flex-nowrap">
                     <button
                        class="btn btn-primary"
                        type="submit"
                        name="add"
                        aria-label="{{ _x('button', 'Add') }}"
                     >
                        <i class="ti ti-plus"></i>
                        <span>{{ _x('button', 'Add') }}</span>
                     </button>
                    {{ pending_reasons|raw }}

                  </div>
               {% else %}
                  <input type="hidden" name="id" value="{{ subitem.fields['id'] }}" />
                  <button class="btn btn-primary me-2" type="submit" name="update">
                     <i class="ti ti-device-floppy"></i>
                     <span>{{ _x('button', 'Save') }}</span>
                  </button>

                  {% if subitem.can(subitem.fields['id'], constant('PURGE')) %}
                     <button class="btn btn-outline-danger me-2" type="submit" name="purge"
                             onclick="return confirm('{{ __('Confirm the final deletion?')|e('js') }}');">
                        <i class="ti ti-trash"></i>
                        <span>{{ _x('button', 'Delete permanently') }}</span>
                     </button>
                  {% endif %}
                  {{ pending_reasons|raw }}
               {% endif %}
            </div>

            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />
         </form>
      </div>

      <script type="text/javascript">
         function itilfollowuptemplate_update{{ rand }}(value) {
            $.ajax({
               url: `${CFG_GLPI.root_doc}/ajax/itilfollowup.php`,
               type: 'POST',
               data: {
                  itilfollowuptemplates_id: value,
                  items_id: '{{ item.fields['id']|e('js') }}',
                  itemtype: '{{ item.getType()|e('js') }}'
               }
            }).done(function (data) {
               var requesttypes_id = isNaN(parseInt(data.requesttypes_id))
                  ? 0
                  : parseInt(data.requesttypes_id);

               // set textarea content ONLY if template defines content
               // If template has no content defined, preserve user's existing content
               if (data.content && data.content.trim() !== '') {
                  setRichTextEditorContent("{{ content_field_id|e('js') }}", data.content);
               }
               // set category
               //need to create new DOM option, because SELECT is remotely-sourced (AJAX)
               //see : https://select2.org/programmatic-control/add-select-clear-items#preselecting-options-in-an-remotely-sourced-ajax-select2
               var newOption = new Option(data.requesttypes_name, requesttypes_id, true, true);
               $("#dropdown_requesttypes_id{{ rand }}").append(newOption).trigger('change');

               if (data.is_private !== undefined) {
                   // set is_private
                   $("#is_private_{{ rand }}")
                       .prop("checked", data.is_private == "0"
                         ? false
                         : true);
               }

               // set predefined pending reason ONLY if template defines one
               // If template has no pending reason defined, preserve user's choices
               if (data.pendingreasons_id > 0) {
                  $("#enable-pending-reasons-{{ rand }}")
                     .prop("checked", true);
                  $("#pending-reasons-setup-{{ rand }}")
                     .collapse('show');

                  //need to create new DOM option, because SELECT is remotely-sourced (AJAX)
                  //see : https://select2.org/programmatic-control/add-select-clear-items#preselecting-options-in-an-remotely-sourced-ajax-select2
                  var newOption = new Option(data.pendingreasons_name, data.pendingreasons_id, true, true);
                  $("#dropdown_pendingreasons_id{{ rand }}")
                     .append(newOption)
                     .trigger('change');
               }
               // If template has NO pending (data.pendingreasons_id is 0 or undefined),
               // DO NOTHING to preserve user's pending choices
            });
         }
      </script>
   {% endif %}
{% endblock %}
