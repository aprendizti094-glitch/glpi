{% if get_current_interface() == 'central' and config('allow_search_global') %}
<form action="{{ path('front/search.php') }}" role="search" method="get" data-submit-once class="m-0 header-global-search-form">
   <div class="input-group input-group-flat header-search-group" style="background: #FFFFFF !important; border-radius: 9999px !important; border: 1px solid rgba(255, 255, 255, 0.95) !important; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12) !important; height: 36px !important; padding: 0 10px 0 16px !important; min-width: 230px !important; display: flex !important; align-items: center !important;">
      <input type="text" class="form-control header-search-input" name="globalsearch" placeholder="{{ __('Search…') }}" style="background: transparent !important; border: none !important; box-shadow: none !important; color: #0F172A !important; font-size: 0.88rem !important; font-weight: 500 !important; padding: 0 !important; height: 100% !important;" />
      <span class="input-group-text" style="background: transparent !important; border: none !important; padding: 0 !important;">
         <button type="submit" class="btn btn-link p-0 m-0 header-search-btn" title="{{ __('Search…') }}" style="border: none !important; background: transparent !important; color: #0120F8 !important; padding: 0 4px !important; display: flex !important; align-items: center !important; cursor: pointer !important;">
            <span class="ti ti-search" aria-hidden="true" style="color: #0120F8 !important; font-size: 1.15rem !important;"></span>
         </button>
      </span>
   </div>
</form>
{% endif %}
